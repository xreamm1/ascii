{
  "rules": {
    "lobbyInfo": {
      ".read": "auth != null",
      ".indexOn": ["created"],
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "online": {
          "$uid": {
            ".write": "auth != null && ($uid == auth.uid || auth.token.email == 'xreamm@ascii-baseplate.game')",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },

    "players": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": {
          ".write": "auth != null && !root.child('bans/' + $code + '/' + auth.uid).exists() && ($id == auth.uid || $id.beginsWith('vit-')) && (!newData.exists() || newData.child('dev').val() != true)"
        }
      }
    },

    "world": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$key": {
          ".write": "auth != null && !root.child('bans/' + $code + '/' + auth.uid).exists() && data.child('p').val() != true && newData.child('p').val() != true"
        }
      }
    },

    "chat": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$msg": {
          ".write": "auth != null && !data.exists() && !root.child('bans/' + $code + '/' + auth.uid).exists()",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('nick').isString() && newData.child('nick').val().length <= 24 && newData.child('t').val() == now && (newData.child('dev').val() != true || auth.token.email == 'xreamm@ascii-baseplate.game') && (!newData.child('pre').exists() || newData.child('pre').val() == root.child('prefixes/' + $code + '/' + auth.uid).val())"
        }
      }
    },

    "announce": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email == 'xreamm@ascii-baseplate.game' || root.child('admins/' + $code + '/' + auth.uid).exists())",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('t').val() == now"
      }
    },

    "admins": { "$code": { ".read": "auth != null", ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'" } },
    "gods": { "$code": { ".read": "auth != null", ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'" } },
    "prefixes": { "$code": { ".read": "auth != null", ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'" } },

    "bans": {
      "$code": {
        ".read": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": { ".read": "auth != null && auth.uid == $id" }
      }
    },
    "sizes": {
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": { ".read": "auth != null && auth.uid == $id" }
      }
    },
    "kicks": {
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": { ".read": "auth != null && auth.uid == $id", ".write": "auth != null && auth.uid == $id && !newData.exists()" }
      }
    },
    "tp": {
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": { ".read": "auth != null && auth.uid == $id", ".write": "auth != null && auth.uid == $id && !newData.exists()" }
      }
    },
    "troll": {
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": { ".read": "auth != null && auth.uid == $id", ".write": "auth != null && auth.uid == $id && !newData.exists()" }
      }
    },

    "hits": {
      "$code": {
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$id": {
          ".read": "auth != null && auth.uid == $id",
          "$hit": {
            ".write": "auth != null && ((!data.exists() && newData.child('by').val() == auth.uid && !root.child('bans/' + $code + '/' + auth.uid).exists()) || (!newData.exists() && $id == auth.uid))",
            ".validate": "newData.child('dmg').isNumber() && newData.child('dmg').val() >= 0 && newData.child('dmg').val() <= 250 && newData.child('t').val() == now"
          }
        }
      }
    },
    "fx": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'xreamm@ascii-baseplate.game'",
        "$fx": {
          ".write": "auth != null && ((!data.exists() && newData.child('by').val() == auth.uid && !root.child('bans/' + $code + '/' + auth.uid).exists()) || (!newData.exists() && data.child('by').val() == auth.uid))",
          ".validate": "newData.child('t').val() == now"
        }
      }
    }
  }
}
